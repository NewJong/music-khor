---
import PageHeader from "@/components/Header/PageHeader";
import Layout from "../layouts/Layout.astro";
import { getRandomAccentColor } from "@/lib/colors";
import PlaylistItemCard from "@/components/Card/PlaylistItemCard";
import Greeting from "@/components/Login/Greeting";
import { fetchData } from "@/lib/fetchData";

const allPlaylists = (await fetchData("get-playlists?include_liked=0")) || [];
const playlists = allPlaylists.slice(0, 7);
const randomPlaylists = allPlaylists
  .filter((playlist) => !playlists.some((p) => p.id === playlist.id))
  .sort(() => Math.random() - 0.5)
  .slice(0, 7);

const randomColor = getRandomAccentColor();
---

<Layout title="Home - KhorMusic">
  <div
    id="playlist-container"
    class="relative transition-all duration-1000"
    style={`background-color: ${randomColor};`}
  >
    <PageHeader client:load />
    <div class="relative z-10 px-4 xs:px-12 pt-8 mb-8">
      <div class="z-10 pb-4 px-4">
        <Greeting client:load />
      </div>
      <div class="flex flex-wrap gap-6 s550:gap-8 justify-evenly s550:justify-start">
        {
          randomPlaylists.map((playlist) => (
            <PlaylistItemCard playlist={playlist} client:load />
          ))
        }
      </div>
      <h1 class="text-3xl font-bold text-green-600 z-10 px-4 pt-8 pb-4" 
      style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5)">New releases</h1>

      <div class="flex flex-wrap gap-6 s550:gap-8 justify-evenly s550:justify-start">
        {
          playlists.map((playlist) => (
            <PlaylistItemCard playlist={playlist} client:load />
          ))
        }
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-zinc-900/80 -z-[1]"
      >
      </div>
    </div>
  </div>
</Layout>
